---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Dimaz Devriza | Full-Stack Web Developer & Network Associate",
  description = "Portofolio Dimaz Devriza: Lulusan S1 Teknologi Informasi (IPK 3,69), Web Developer Full-Stack Laravel, tersertifikasi MikroTik MTCNA dan Microsoft Azure AI Fundamentals.",
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="./favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph Meta -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    
    <!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Theme Initialization Script (R-21 / R-34: No FOUC) -->
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'light') {
        document.documentElement.classList.add('light');
      } else {
        document.documentElement.classList.remove('light');
      }
    </script>
  </head>
  <body class="min-h-screen font-sans selection:bg-sky-400 selection:text-slate-950 relative transition-colors duration-300">
    
    <!-- Cinematic High-Tech Preloader -->
    <div id="preloader" aria-hidden="true">
      <div class="preloader-shutter-top"></div>
      <div class="preloader-shutter-bottom"></div>
      <div id="preloader-content" class="relative z-20 flex flex-col items-center text-center px-4">
        <!-- Monogram Badge -->
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-sky-400 to-blue-600 p-[1.5px] shadow-[0_0_35px_rgba(56,189,248,0.6)] mb-6">
          <div class="w-full h-full rounded-[calc(1rem-1.5px)] bg-slate-950 flex items-center justify-center font-extrabold text-sky-400 text-base tracking-wider">
            DD
          </div>
        </div>

        <!-- Digital High-Tech Counter -->
        <div class="flex items-baseline gap-1 font-mono text-4xl sm:text-5xl font-extrabold text-white mb-3">
          <span id="preloader-num">00</span>
          <span class="text-sky-400 text-lg">%</span>
        </div>

        <!-- Progress Laser Track -->
        <div class="w-56 h-[2px] bg-slate-800 rounded-full overflow-hidden relative mb-4">
          <div id="preloader-bar" class="absolute inset-0 bg-gradient-to-r from-sky-400 via-blue-500 to-indigo-500 origin-left scale-x-0"></div>
        </div>

        <p class="text-[11px] font-mono uppercase tracking-[0.22em] text-slate-400">
          Memuat Sistem & Rekayasa Arsitektur
        </p>
      </div>
    </div>

    <!-- Living Constellation / Particle Mesh Canvas -->
    <canvas id="ambient-canvas" class="pointer-events-none fixed inset-0 z-0 opacity-40"></canvas>

    <!-- Tactile Film Grain Texture Overlay -->
    <div class="film-grain" aria-hidden="true"></div>

    <!-- Dynamic Mouse Cursor Spotlight Layer -->
    <div
      id="cursor-spotlight"
      class="pointer-events-none fixed inset-0 z-0 transition-opacity duration-500 opacity-0"
      aria-hidden="true"
    ></div>

    <!-- Aksesibilitas: Lewati ke konten utama -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-50 px-4 py-2 bg-sky-400 text-slate-950 font-semibold rounded-lg shadow-lg"
    >
      Lewati ke konten utama
    </a>

    <slot />

    <script>
      import { gsap } from 'gsap';

      document.addEventListener('DOMContentLoaded', () => {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // 1. Interactive Ambient Constellation Canvas
        const canvas = document.getElementById('ambient-canvas') as HTMLCanvasElement | null;
        if (canvas && !prefersReducedMotion) {
          const ctx = canvas.getContext('2d');
          if (ctx) {
            let width = (canvas.width = window.innerWidth);
            let height = (canvas.height = window.innerHeight);

            const nodes: Array<{
              x: number;
              y: number;
              vx: number;
              vy: number;
              radius: number;
              color: string;
            }> = [];

            const nodeCount = Math.min(38, Math.floor(width / 35));
            const colors = ['#38BDF8', '#60A5FA', '#818CF8'];

            for (let i = 0; i < nodeCount; i++) {
              nodes.push({
                x: Math.random() * width,
                y: Math.random() * height,
                vx: (Math.random() - 0.5) * 0.45,
                vy: (Math.random() - 0.5) * 0.45,
                radius: Math.random() * 1.5 + 1.0,
                color: colors[Math.floor(Math.random() * colors.length)],
              });
            }

            let mouseX = -9999;
            let mouseY = -9999;

            window.addEventListener('mousemove', (e) => {
              mouseX = e.clientX;
              mouseY = e.clientY;
            });

            window.addEventListener('resize', () => {
              width = canvas.width = window.innerWidth;
              height = canvas.height = window.innerHeight;
            });

            const render = () => {
              ctx.clearRect(0, 0, width, height);

              // Update & Draw Nodes
              for (let i = 0; i < nodes.length; i++) {
                const node = nodes[i];
                node.x += node.vx;
                node.y += node.vy;

                if (node.x < 0) node.x = width;
                if (node.x > width) node.x = 0;
                if (node.y < 0) node.y = height;
                if (node.y > height) node.y = 0;

                ctx.beginPath();
                ctx.arc(node.x, node.y, node.radius, 0, Math.PI * 2);
                ctx.fillStyle = node.color;
                ctx.globalAlpha = 0.5;
                ctx.fill();

                // Connect to other nodes
                for (let j = i + 1; j < nodes.length; j++) {
                  const other = nodes[j];
                  const dx = node.x - other.x;
                  const dy = node.y - other.y;
                  const dist = Math.sqrt(dx * dx + dy * dy);

                  if (dist < 120) {
                    ctx.beginPath();
                    ctx.moveTo(node.x, node.y);
                    ctx.lineTo(other.x, other.y);
                    ctx.strokeStyle = '#38BDF8';
                    ctx.globalAlpha = (1 - dist / 120) * 0.16;
                    ctx.lineWidth = 0.8;
                    ctx.stroke();
                  }
                }

                // Connect to mouse pointer
                const dxMouse = node.x - mouseX;
                const dyMouse = node.y - mouseY;
                const distMouse = Math.sqrt(dxMouse * dxMouse + dyMouse * dyMouse);

                if (distMouse < 140) {
                  ctx.beginPath();
                  ctx.moveTo(node.x, node.y);
                  ctx.lineTo(mouseX, mouseY);
                  ctx.strokeStyle = '#38BDF8';
                  ctx.globalAlpha = (1 - distMouse / 140) * 0.28;
                  ctx.lineWidth = 1.0;
                  ctx.stroke();
                }
              }

              requestAnimationFrame(render);
            };

            render();
          }
        }

        // 2. Interactive Cursor Spotlight
        const spotlight = document.getElementById('cursor-spotlight');
        if (spotlight && !prefersReducedMotion) {
          window.addEventListener('mousemove', (e) => {
            spotlight.style.opacity = '1';
            spotlight.style.background = `radial-gradient(700px circle at ${e.clientX}px ${e.clientY}px, rgba(56, 189, 248, 0.09), transparent 80%)`;
          });

          window.addEventListener('mouseleave', () => {
            spotlight.style.opacity = '0';
          });
        }

        // 3. Cinematic Entrance Preloader & Hero Choreography
        const preloader = document.getElementById('preloader');
        const preloaderNum = document.getElementById('preloader-num');
        const preloaderBar = document.getElementById('preloader-bar');
        const preloaderContent = document.getElementById('preloader-content');
        const shutterTop = document.querySelector('.preloader-shutter-top');
        const shutterBottom = document.querySelector('.preloader-shutter-bottom');

        if (preloader && !prefersReducedMotion) {
          const countObj = { val: 0 };
          const introTl = gsap.timeline({ defaults: { ease: 'power3.out' } });

          // A. Counter tick & laser bar progress (0.45s)
          introTl.to(countObj, {
            val: 100,
            duration: 0.45,
            ease: 'power2.inOut',
            onUpdate: () => {
              if (preloaderNum) {
                const current = Math.floor(countObj.val);
                preloaderNum.textContent = current < 10 ? `0${current}` : `${current}`;
              }
            },
          });

          if (preloaderBar) {
            introTl.to(preloaderBar, {
              scaleX: 1,
              duration: 0.45,
              ease: 'power2.inOut',
            }, 0);
          }

          // B. Preloader Content subtle pulse out (0.2s)
          if (preloaderContent) {
            introTl.to(preloaderContent, {
              scale: 1.05,
              opacity: 0,
              duration: 0.2,
              ease: 'power2.in',
            }, '+=0.05');
          }

          // C. Shutter Split Curtain Reveal (0.65s)
          introTl.addLabel('reveal');

          if (shutterTop && shutterBottom) {
            introTl.to(shutterTop, {
              yPercent: -100,
              duration: 0.65,
              ease: 'power4.inOut',
            }, 'reveal');

            introTl.to(shutterBottom, {
              yPercent: 100,
              duration: 0.65,
              ease: 'power4.inOut',
            }, 'reveal');
          }

          // D. Hero Visual Choreography (Synchronized at reveal+=0.1)
          introTl.fromTo('header',
            { y: -50, opacity: 0 },
            { y: 0, opacity: 1, duration: 0.7, ease: 'power3.out' },
            'reveal+=0.1'
          );

          introTl.fromTo('#hero-status',
            { scale: 0.8, opacity: 0 },
            { scale: 1, opacity: 1, duration: 0.6, ease: 'back.out(2)' },
            'reveal+=0.15'
          );

          introTl.fromTo('.title-token',
            { y: '110%', rotateX: -35, opacity: 0 },
            { y: '0%', rotateX: 0, opacity: 1, duration: 0.8, stagger: 0.08, ease: 'power4.out' },
            'reveal+=0.2'
          );

          introTl.fromTo('#hero-subtitle',
            { y: 20, opacity: 0 },
            { y: 0, opacity: 1, duration: 0.7, ease: 'power3.out' },
            'reveal+=0.28'
          );

          introTl.fromTo('#hero-bio',
            { y: 20, opacity: 0 },
            { y: 0, opacity: 1, duration: 0.7, ease: 'power3.out' },
            'reveal+=0.34'
          );

          introTl.fromTo('#hero-cta',
            { y: 20, opacity: 0 },
            { y: 0, opacity: 1, duration: 0.7, ease: 'back.out(1.7)' },
            'reveal+=0.4'
          );

          introTl.fromTo('#hero-meta',
            { opacity: 0 },
            { opacity: 1, duration: 0.6 },
            'reveal+=0.45'
          );

          // Right Column: Machined Hardware Card 3D entrance
          introTl.fromTo('#hero-card',
            { scale: 0.88, y: 35, rotateY: 10, opacity: 0 },
            { scale: 1, y: 0, rotateY: 0, opacity: 1, duration: 0.85, ease: 'power3.out' },
            'reveal+=0.22'
          );

          introTl.fromTo('#card-badge-status',
            { scale: 0, opacity: 0 },
            { scale: 1, opacity: 1, duration: 0.5, ease: 'back.out(2.2)' },
            'reveal+=0.45'
          );

          introTl.fromTo('#card-badge-metric',
            { scale: 0, opacity: 0 },
            { scale: 1, opacity: 1, duration: 0.5, ease: 'back.out(2.2)' },
            'reveal+=0.55'
          );

          introTl.call(() => {
            if (preloader) {
              preloader.style.display = 'none';
            }
          });
        } else if (preloader) {
          preloader.style.display = 'none';
        }

        // 4. Interactive 3D Tilt on Hero Portrait Card
        const cardContainer = document.getElementById('hero-card-container');
        const heroCard = document.getElementById('hero-card');
        const cardShine = document.getElementById('card-shine');

        if (cardContainer && heroCard && !prefersReducedMotion) {
          cardContainer.addEventListener('mousemove', (e) => {
            const rect = cardContainer.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;
            
            const rotateX = ((y - centerY) / centerY) * -11;
            const rotateY = ((x - centerX) / centerX) * 11;

            heroCard.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.025, 1.025, 1.025)`;

            if (cardShine) {
              cardShine.style.opacity = '1';
              cardShine.style.background = `radial-gradient(circle 260px at ${x}px ${y}px, rgba(255,255,255,0.18), transparent 70%)`;
            }
          });

          cardContainer.addEventListener('mouseleave', () => {
            heroCard.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
            if (cardShine) {
              cardShine.style.opacity = '0';
            }
          });
        }

        // 5. Magnetic CTA Button Physics
        const magneticBtns = document.querySelectorAll('.magnetic-btn');
        if (!prefersReducedMotion) {
          magneticBtns.forEach((btn) => {
            btn.addEventListener('mousemove', (e: any) => {
              const rect = (btn as HTMLElement).getBoundingClientRect();
              const x = e.clientX - rect.left - rect.width / 2;
              const y = e.clientY - rect.top - rect.height / 2;

              gsap.to(btn, {
                x: x * 0.22,
                y: y * 0.22,
                duration: 0.3,
                ease: 'power2.out',
              });
            });

            btn.addEventListener('mouseleave', () => {
              gsap.to(btn, {
                x: 0,
                y: 0,
                duration: 0.5,
                ease: 'elastic.out(1.2, 0.4)',
              });
            });
          });
        }

        // 6. Smooth Counter Animation on Metric Numbers
        const metricCounters = document.querySelectorAll('.metric-counter');
        let countersAnimated = false;

        const animateCounters = () => {
          if (countersAnimated || prefersReducedMotion) return;
          countersAnimated = true;

          metricCounters.forEach((counter) => {
            const target = parseFloat(counter.getAttribute('data-target') || '0');
            const decimals = parseInt(counter.getAttribute('data-decimals') || '0', 10);
            const obj = { val: 0 };

            gsap.to(obj, {
              val: target,
              duration: 2.0,
              ease: 'power2.out',
              onUpdate: () => {
                if (decimals > 0) {
                  counter.textContent = obj.val.toFixed(decimals).replace('.', ',');
                } else {
                  counter.textContent = Math.round(obj.val).toString();
                }
              },
            });
          });
        };

        // 7. Scroll Reveal Observer for Metrics and Cards
        const revealObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              if (entry.target.classList.contains('metric-card')) {
                entry.target.classList.add('opacity-100', 'translate-y-0');
                entry.target.classList.remove('opacity-0', 'translate-y-8');
                animateCounters();
              } else {
                entry.target.classList.add('opacity-100', 'translate-y-0');
                entry.target.classList.remove('opacity-0', 'translate-y-8');
              }
              revealObserver.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.15,
          rootMargin: '0px 0px -40px 0px',
        });

        document.querySelectorAll('.metric-card, .reveal-on-scroll').forEach((el) => {
          revealObserver.observe(el);
        });

      });
    </script>
  </body>
</html>
