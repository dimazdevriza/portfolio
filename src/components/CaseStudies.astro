---
// Proyek komersial dan sistem produksi nyata Dimaz Devriza
---

<section id="projects" class="py-28 sm:py-36 relative">
  <div class="max-w-6xl mx-auto px-6">
    
    <!-- Section Header -->
    <div class="mb-20 reveal-on-scroll opacity-0 translate-y-8">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.1] backdrop-blur-md text-xs font-semibold text-sky-400 mb-4 shadow-sm">
        <span>Portofolio Pekerjaan</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-5 leading-tight">
        Proyek Klien & Sistem Produksi
      </h2>
      <p class="text-slate-300 text-base sm:text-lg max-w-2xl leading-relaxed font-normal">
        Aplikasi web komersial skala produksi yang saya bangun secara profesional untuk klien dan institusi. Karena sistem ini menangani operasional bisnis dan data internal klien, ringkasan teknis di bawah memaparkan arsitektur, penanganan konkurensi, dan solusi rekayasa yang diterapkan.
      </p>
    </div>

    <div class="space-y-16">

      <!-- PROYEK 1: D'ROYAL VILLAGE LOGISTIK -->
      <div class="bezel-outer project-card reveal-on-scroll opacity-0 translate-y-8">
        <article class="bezel-inner p-6 sm:p-10">
          
          <!-- Header Bar -->
          <div class="flex flex-wrap items-start justify-between gap-4 mb-8 pb-6 border-b border-white/[0.06]">
            <div>
              <div class="flex flex-wrap items-center gap-2.5 mb-3">
                <span class="px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-300 border border-amber-500/20">
                  Proyek Klien Komersial
                </span>
                <span class="px-3 py-1 rounded-full text-xs font-medium text-slate-400 bg-white/[0.03] border border-white/[0.06]">
                  Kota Padang, Indonesia
                </span>
                <span class="px-3 py-1 rounded-full text-xs font-medium text-slate-400 bg-white/[0.03] border border-white/[0.06]">
                  Januari 2026 - Oktober 2026
                </span>
              </div>
              <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
                D'Royal Village: Sistem Logistik & Pengendalian Biaya Proyek
              </h3>
            </div>
            
            <div>
              <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-semibold border border-emerald-500/20 shadow-sm">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
                </span>
                Aktif Beroperasi di Lapangan
              </span>
            </div>
          </div>

          <p class="text-slate-300 text-base sm:text-lg leading-relaxed mb-8">
            Merancang, membangun, dan men-deploy Sistem Informasi Logistik dan Pengendalian Biaya Proyek berbasis web untuk developer perumahan D'Royal Village. Menggantikan proses manual dan spreadsheet Excel dengan sistem multi-gudang dan multi-cluster terpadu yang memonitor realisasi fisik unit rumah secara real-time.
          </p>

          <!-- Interactive macOS Window Frame: ACID Concurrency Flow with Interactive Tabs -->
          <div class="rounded-2xl border border-white/[0.1] bg-slate-950/85 overflow-hidden mb-10 shadow-2xl backdrop-blur-md">
            
            <!-- Window Title Bar & Interactive Tab Switcher -->
            <div class="px-4 py-3 bg-white/[0.02] border-b border-white/[0.08] flex flex-wrap items-center justify-between gap-4 text-xs text-slate-400">
              <div class="flex items-center gap-2">
                <div class="flex gap-2" aria-hidden="true">
                  <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block shadow-sm"></span>
                  <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block shadow-sm"></span>
                  <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block shadow-sm"></span>
                </div>
                <span class="ml-3 font-semibold text-slate-200">Arsitektur Produksi: Transaksi & Database</span>
              </div>

              <!-- Interactive Tabs -->
              <div class="flex items-center gap-1.5 bg-black/40 p-1 rounded-xl border border-white/[0.06]">
                <button
                  type="button"
                  data-tab="flow"
                  class="arch-tab-btn active px-3 py-1 rounded-lg text-xs font-semibold bg-white/[0.1] text-white transition-all duration-300"
                >
                  Alur Transaksi ACID
                </button>
                <button
                  type="button"
                  data-tab="concurrency"
                  class="arch-tab-btn px-3 py-1 rounded-lg text-xs font-medium text-slate-400 hover:text-white hover:bg-white/[0.05] transition-all duration-300"
                >
                  Solusi Konkurensi
                </button>
                <button
                  type="button"
                  data-tab="tests"
                  class="arch-tab-btn px-3 py-1 rounded-lg text-xs font-medium text-slate-400 hover:text-white hover:bg-white/[0.05] transition-all duration-300"
                >
                  154 Pengujian Otomatis
                </button>
              </div>
            </div>

            <!-- Tab Content 1: 4-Step Transaction Flow -->
            <div id="tab-content-flow" class="arch-tab-content p-6 overflow-x-auto">
              <div class="min-w-[640px] grid grid-cols-4 gap-4">
                
                <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.06] flex flex-col justify-between hover:border-sky-400/40 transition-colors group cursor-default">
                  <div>
                    <span class="text-[11px] font-semibold text-sky-400 mb-1 block">Langkah 01</span>
                    <span class="font-bold text-white text-sm block mb-1">Permintaan Stok</span>
                  </div>
                  <span class="text-xs text-slate-400 leading-snug">Pengawas alokasikan batch material ke nomor unit rumah</span>
                </div>

                <div class="p-4 rounded-xl bg-sky-500/[0.08] border border-sky-400/40 flex flex-col justify-between shadow-[0_0_20px_rgba(56,189,248,0.15)] group cursor-default">
                  <div>
                    <span class="text-[11px] font-semibold text-sky-300 mb-1 block">Langkah 02: Kunci Baris</span>
                    <code class="font-mono text-sky-200 font-bold text-xs block mb-1">lockForUpdate()</code>
                  </div>
                  <span class="text-xs text-slate-300 leading-snug">Pessimistic row lock di MySQL saat transaksi dimulai</span>
                </div>

                <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.06] flex flex-col justify-between hover:border-sky-400/40 transition-colors group cursor-default">
                  <div>
                    <span class="text-[11px] font-semibold text-sky-400 mb-1 block">Langkah 03</span>
                    <span class="font-bold text-white text-sm block mb-1">Validasi Kuantitas</span>
                  </div>
                  <span class="text-xs text-slate-400 leading-snug">Pemeriksaan stok fisik aman dan belum habis dialokasikan</span>
                </div>

                <div class="p-4 rounded-xl bg-emerald-500/[0.08] border border-emerald-400/40 flex flex-col justify-between shadow-[0_0_20px_rgba(52,211,153,0.15)] group cursor-default">
                  <div>
                    <span class="text-[11px] font-semibold text-emerald-300 mb-1 block">Langkah 04</span>
                    <span class="font-bold text-emerald-200 text-sm block mb-1">Commit Transaksi</span>
                  </div>
                  <span class="text-xs text-slate-300 leading-snug">Biaya dibukukan ke RAB unit & mutasi tersimpan permanen</span>
                </div>

              </div>
            </div>

            <!-- Tab Content 2: Concurrency Comparison -->
            <div id="tab-content-concurrency" class="arch-tab-content hidden p-6">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/25">
                  <div class="flex items-center gap-2 mb-2 text-rose-300 font-bold text-xs">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    <span>Tanpa Pessimistic Locking (Race Condition)</span>
                  </div>
                  <p class="text-xs text-slate-300 leading-relaxed mb-3">
                    Dua pengawas gudang membuka material batch yang sama dengan sisa 10 zak semen. Mandor A mengajukan 8 zak, Mandor B mengajukan 7 zak secara bersamaan. Keduanya lolos validasi karena membaca stok awal yang sama, mengakibatkan <strong>stok minus (-5 zak)</strong> dan kerugian finansial.
                  </p>
                  <span class="text-[11px] font-mono text-rose-400">Hasil: Kegagalan Integritas Inventaris</span>
                </div>

                <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/25">
                  <div class="flex items-center gap-2 mb-2 text-emerald-300 font-bold text-xs">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    <span>Dengan lockForUpdate() & Transaksi DB Dimaz</span>
                  </div>
                  <p class="text-xs text-slate-300 leading-relaxed mb-3">
                    Saat Mandor A memulai alokasi, baris batch dikunci seketika oleh database. Permintaan Mandor B mengantre hingga transaksi Mandor A selesai di-commit. Mandor B kemudian membaca sisa stok baru (2 zak) dan sistem dengan aman menolak permintaan 7 zak.
                  </p>
                  <span class="text-[11px] font-mono text-emerald-400">Hasil: Zero Stok Minus & 100% Data Konsisten</span>
                </div>
              </div>
            </div>

            <!-- Tab Content 3: 154 Automated Tests Summary -->
            <div id="tab-content-tests" class="arch-tab-content hidden p-6">
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-center">
                <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.06]">
                  <span class="text-3xl font-extrabold text-sky-400 block mb-1">154</span>
                  <span class="text-xs text-slate-300 font-semibold block mb-0.5">Automated Tests Passed</span>
                  <span class="text-[11px] text-slate-500">Suite MySQL Terisolasi</span>
                </div>
                <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.06]">
                  <span class="text-3xl font-extrabold text-emerald-400 block mb-1">816</span>
                  <span class="text-xs text-slate-300 font-semibold block mb-0.5">Assertions Terverifikasi</span>
                  <span class="text-[11px] text-slate-500">Cakupan alur bisnis kritis</span>
                </div>
                <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.06]">
                  <span class="text-3xl font-extrabold text-indigo-400 block mb-1">0</span>
                  <span class="text-xs text-slate-300 font-semibold block mb-0.5">Kegagalan Regresi</span>
                  <span class="text-[11px] text-slate-500">Pest & PHPUnit Test Harness</span>
                </div>
              </div>
            </div>

          </div>

          <!-- Technical Highlights Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-8">
            
            <div class="p-5 rounded-2xl bg-white/[0.02] border border-white/[0.06] hover:border-white/[0.12] transition-colors">
              <div class="w-9 h-9 rounded-xl bg-sky-500/10 border border-sky-400/20 flex items-center justify-center text-sky-400 mb-3.5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                </svg>
              </div>
              <h4 class="text-sm font-bold text-white mb-2">
                Integritas Database Transaksi ACID
              </h4>
              <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
                Menjamin tidak ada mutasi stok gantung atau stok minus ketika multi-mandor mengajukan material secara serentak, didukung mekanisme rollback otomatis jika terjadi kegagalan sistem.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-white/[0.02] border border-white/[0.06] hover:border-white/[0.12] transition-colors">
              <div class="w-9 h-9 rounded-xl bg-blue-500/10 border border-blue-400/20 flex items-center justify-center text-blue-400 mb-3.5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                </svg>
              </div>
              <h4 class="text-sm font-bold text-white mb-2">
                Inventaris Batch Harga & Beban Unit
              </h4>
              <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
                Valuasi material dihitung per batch harga pembelian secara presisi (tanpa dirata-rata). Biaya pemakaian dibebankan langsung ke unit rumah sehingga selisih anggaran RAB terpantau akurat.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-white/[0.02] border border-white/[0.06] hover:border-white/[0.12] transition-colors">
              <div class="w-9 h-9 rounded-xl bg-indigo-500/10 border border-indigo-400/20 flex items-center justify-center text-indigo-400 mb-3.5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                </svg>
              </div>
              <h4 class="text-sm font-bold text-white mb-2">
                Pertanggungjawaban Alat & Biaya Cluster
              </h4>
              <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
                Alur penyelesaian unit rumah mewajibkan verifikasi status fisik alat (baik, rusak, hilang). Biaya sewa alat berat dan fasilitas bersama (drainase, listrik) dicatat terpisah pada beban cluster.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-white/[0.02] border border-white/[0.06] hover:border-white/[0.12] transition-colors">
              <div class="w-9 h-9 rounded-xl bg-purple-500/10 border border-purple-400/20 flex items-center justify-center text-purple-400 mb-3.5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
              </div>
              <h4 class="text-sm font-bold text-white mb-2">
                Otorisasi Multi-Peran (RBAC) & Migrasi Excel
              </h4>
              <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
                Pemisahan wewenang antara Logistik, Pengawas (Mandor), dan Manajemen Keuangan. Dilengkapi modul importir Excel khusus untuk migrasi saldo awal data historis perusahaan.
              </p>
            </div>

          </div>

          <!-- Technologies -->
          <div class="flex flex-wrap items-center gap-2 pt-5 border-t border-white/[0.06]">
            <span class="text-xs font-medium text-slate-400 mr-2">Teknologi Utama:</span>
            {["Laravel 11", "Livewire 3", "Alpine.js", "Tailwind CSS", "MySQL", "Git", "Pessimistic Locking", "Spatie Permission"].map((tech) => (
              <span class="px-3 py-1 rounded-full text-xs font-medium bg-white/[0.03] text-slate-300 border border-white/[0.08]">
                {tech}
              </span>
            ))}
          </div>

        </article>
      </div>


      <!-- PROYEK 2: LMS SMAN 15 PADANG -->
      <div class="bezel-outer project-card reveal-on-scroll opacity-0 translate-y-8">
        <article class="bezel-inner p-6 sm:p-10">
          
          <div class="flex flex-wrap items-start justify-between gap-4 mb-8 pb-6 border-b border-white/[0.06]">
            <div>
              <div class="flex flex-wrap items-center gap-2.5 mb-3">
                <span class="px-3 py-1 rounded-full text-xs font-semibold bg-blue-500/10 text-blue-300 border border-blue-500/20">
                  Proyek Resmi Sekolah
                </span>
                <span class="px-3 py-1 rounded-full text-xs font-medium text-slate-400 bg-white/[0.03] border border-white/[0.06]">
                  Kota Padang, Indonesia
                </span>
                <span class="px-3 py-1 rounded-full text-xs font-medium text-slate-400 bg-white/[0.03] border border-white/[0.06]">
                  Maret 2026 - Juli 2026
                </span>
              </div>
              <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
                SMA Negeri 15 Padang: Learning Management System (LMS)
              </h3>
            </div>
            
            <div>
              <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-semibold border border-emerald-500/20 shadow-sm">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
                </span>
                Digunakan Aktif oleh Sekolah
              </span>
            </div>
          </div>

          <p class="text-slate-300 text-base sm:text-lg leading-relaxed mb-8">
            Berkolaborasi dengan rekan pengembang merancang, membangun, dan men-deploy platform Learning Management System (LMS) berbasis web untuk guru dan siswa di SMA Negeri 15 Padang. Sistem ini menangani aktivitas pembelajaran harian, presensi kelas, pengumpulan tugas, forum diskusi, dan ujian online.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-8">
            <div class="p-5 rounded-2xl bg-white/[0.02] border border-white/[0.06]">
              <h4 class="text-sm font-bold text-white mb-2">Kolaborasi Git Terstruktur</h4>
              <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
                Manajemen kode menggunakan Git version control dengan pembagian modul yang rapi antara fitur manajemen kelas, tugas, dan rekapitulasi nilai siswa.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-white/[0.02] border border-white/[0.06]">
              <h4 class="text-sm font-bold text-white mb-2">Distribusi Materi & Penugasan</h4>
              <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
                Penyampaian materi ajar digital, pengunggahan tugas siswa dengan validasi format berkas, dan sistem penilaian otomatis untuk memudahkan guru.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-white/[0.02] border border-white/[0.06]">
              <h4 class="text-sm font-bold text-white mb-2">Deployment Hosting Produksi</h4>
              <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
                Mengonfigurasi dan men-deploy sistem secara langsung ke hosting Rumahweb menggunakan Git, memastikan stabilitas server dan uptime tinggi.
              </p>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-2 pt-5 border-t border-white/[0.06]">
            <span class="text-xs font-medium text-slate-400 mr-2">Teknologi Utama:</span>
            {["Laravel", "PHP", "MySQL", "Tailwind CSS", "Git", "Hosting Rumahweb", "Deployment Produksi"].map((tech) => (
              <span class="px-3 py-1 rounded-full text-xs font-medium bg-white/[0.03] text-slate-300 border border-white/[0.08]">
                {tech}
              </span>
            ))}
          </div>

        </article>
      </div>


      <!-- PROYEK 3: LLDIKTI X SILAB -->
      <div class="bezel-outer project-card reveal-on-scroll opacity-0 translate-y-8">
        <article class="bezel-inner p-6 sm:p-10">
          
          <div class="flex flex-wrap items-start justify-between gap-4 mb-8 pb-6 border-b border-white/[0.06]">
            <div>
              <div class="flex flex-wrap items-center gap-2.5 mb-3">
                <span class="px-3 py-1 rounded-full text-xs font-semibold bg-purple-500/10 text-purple-300 border border-purple-500/20">
                  Pengalaman Magang (Internship)
                </span>
                <span class="px-3 py-1 rounded-full text-xs font-medium text-slate-400 bg-white/[0.03] border border-white/[0.06]">
                  Kota Padang, Indonesia
                </span>
                <span class="px-3 py-1 rounded-full text-xs font-medium text-slate-400 bg-white/[0.03] border border-white/[0.06]">
                  Juni 2025 - Oktober 2025
                </span>
              </div>
              <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
                Pengalaman Magang: SiLAB LLDIKTI Wilayah X (Sistem Pembookingan Laboratorium)
              </h3>
            </div>
            
            <div>
              <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-700/50 text-slate-300 text-xs font-semibold border border-white/[0.1]">
                Selesai & Terverifikasi
              </span>
            </div>
          </div>

          <p class="text-slate-300 text-base sm:text-lg leading-relaxed mb-8">
            Selama magang di Kantor LLDIKTI Wilayah X, bertugas memelihara, memperbaiki, dan mengembangkan Sistem Informasi Pembookingan Pemakaian Laboratorium (SiLAB). Menyempurnakan pendaftaran pengguna, validasi berkas persyaratan, serta alur verifikasi pemesanan oleh admin.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-8">
            <div class="p-5 rounded-2xl bg-white/[0.02] border border-white/[0.06]">
              <h4 class="text-sm font-bold text-white mb-2">Pencegahan Bentrokan Jadwal</h4>
              <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
                Menyempurnakan alur verifikasi admin dalam menyetujui permohonan reservasi fasilitas laboratorium dari berbagai perguruan tinggi agar tidak terjadi tumpang tindih jadwal.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-white/[0.02] border border-white/[0.06]">
              <h4 class="text-sm font-bold text-white mb-2">Pengelolaan Berkas Digital</h4>
              <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
                Membangun alur unggah dan unduh dokumen administrasi berbasis PDF dengan pengecekan format terstruktur demi menjaga kepatuhan birokrasi dan ketertiban arsip.
              </p>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-2 pt-5 border-t border-white/[0.06]">
            <span class="text-xs font-medium text-slate-400 mr-2">Teknologi Utama:</span>
            {["PHP", "MySQL", "Bootstrap", "Git", "Relational Database", "Validasi Dokumen"].map((tech) => (
              <span class="px-3 py-1 rounded-full text-xs font-medium bg-white/[0.03] text-slate-300 border border-white/[0.08]">
                {tech}
              </span>
            ))}
          </div>

        </article>
      </div>

    </div>

  </div>
</section>

<script>
  // Tab Switcher logic for D'Royal Village Interactive Architecture Window
  const tabButtons = document.querySelectorAll('.arch-tab-btn');
  const tabContents = document.querySelectorAll('.arch-tab-content');

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tabId = btn.getAttribute('data-tab');

      // Update button active states
      tabButtons.forEach((b) => {
        b.classList.remove('active', 'bg-white/[0.1]', 'text-white');
        b.classList.add('text-slate-400');
      });
      btn.classList.add('active', 'bg-white/[0.1]', 'text-white');
      btn.classList.remove('text-slate-400');

      // Toggle content
      tabContents.forEach((c) => {
        c.classList.add('hidden');
      });
      const activeContent = document.getElementById(`tab-content-${tabId}`);
      if (activeContent) {
        activeContent.classList.remove('hidden');
      }
    });
  });
</script>
