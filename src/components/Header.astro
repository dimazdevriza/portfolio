---
const cvUrl = "https://drive.google.com/file/d/1KKT_Tqwmpti5bLdsz5CrOPW236-LqkUC/view?usp=sharing";
---

<header class="fixed top-4 inset-x-0 z-50 px-4 pointer-events-none">
  <div class="max-w-4xl mx-auto glass-dock rounded-full px-4 py-2.5 flex items-center justify-between shadow-glass pointer-events-auto transition-all duration-300">
    <!-- Brand / Name -->
    <a href="#" class="flex items-center gap-2.5 group focus:outline-none" aria-label="Dimaz Devriza - Kembali ke atas">
      <div class="w-8 h-8 rounded-full bg-accent/20 border border-accent/40 flex items-center justify-center font-bold text-accent text-xs group-hover:scale-105 transition-transform">
        DD
      </div>
      <span class="font-bold text-sm tracking-tight text-white group-hover:text-accent transition-colors">
        Dimaz Devriza
      </span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 text-xs font-medium text-slate-300" aria-label="Navigasi Utama">
      <a href="#case-studies" class="px-3 py-1.5 rounded-full hover:text-white hover:bg-white/5 transition-colors">
        Studi Kasus
      </a>
      <a href="#skills" class="px-3 py-1.5 rounded-full hover:text-white hover:bg-white/5 transition-colors">
        Keahlian
      </a>
      <a href="#certifications" class="px-3 py-1.5 rounded-full hover:text-white hover:bg-white/5 transition-colors">
        Sertifikasi
      </a>
      <a href="#experience" class="px-3 py-1.5 rounded-full hover:text-white hover:bg-white/5 transition-colors">
        Pengalaman
      </a>
      <a href="#contact" class="px-3 py-1.5 rounded-full hover:text-white hover:bg-white/5 transition-colors">
        Kontak
      </a>
    </nav>

    <!-- Action Buttons -->
    <div class="flex items-center gap-2">
      <a
        href={cvUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="tactile-btn inline-flex items-center gap-1.5 text-xs font-semibold px-3.5 py-2 rounded-full bg-accent text-slate-950 hover:bg-sky-300 shadow-glow-accent"
        aria-label="Lihat CV dalam format PDF di Google Drive (buka di tab baru)"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <span>Lihat CV (PDF)</span>
      </a>

      <!-- Mobile Menu Toggle Button (Min 44px tap target) -->
      <button
        id="mobile-nav-toggle"
        class="md:hidden flex items-center justify-center w-11 h-11 rounded-full text-slate-300 hover:text-white hover:bg-white/10 focus:outline-none"
        aria-label="Buka menu navigasi"
        aria-expanded="false"
      >
        <svg class="w-5 h-5 menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-nav-menu"
    class="hidden md:hidden max-w-sm mx-auto mt-2 glass-dock rounded-2xl p-4 shadow-2xl flex flex-col gap-2 pointer-events-auto text-sm"
  >
    <a href="#case-studies" class="mobile-nav-link py-2 px-3 rounded-lg hover:bg-white/5 text-slate-200">Studi Kasus</a>
    <a href="#skills" class="mobile-nav-link py-2 px-3 rounded-lg hover:bg-white/5 text-slate-200">Keahlian</a>
    <a href="#certifications" class="mobile-nav-link py-2 px-3 rounded-lg hover:bg-white/5 text-slate-200">Sertifikasi</a>
    <a href="#experience" class="mobile-nav-link py-2 px-3 rounded-lg hover:bg-white/5 text-slate-200">Pengalaman</a>
    <a href="#contact" class="mobile-nav-link py-2 px-3 rounded-lg hover:bg-white/5 text-slate-200">Kontak</a>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-nav-toggle');
  const menu = document.getElementById('mobile-nav-menu');
  const links = document.querySelectorAll('.mobile-nav-link');

  if (toggleBtn && menu) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
    });

    links.forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
