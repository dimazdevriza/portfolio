---
const cvUrl = "https://drive.google.com/file/d/1KKT_Tqwmpti5bLdsz5CrOPW236-LqkUC/view?usp=sharing";
---

<header class="fixed top-5 inset-x-0 z-50 px-4 pointer-events-none">
  <div class="max-w-4xl mx-auto apple-glass-island rounded-full px-5 py-2.5 flex items-center justify-between pointer-events-auto transition-all duration-500 hover:border-white/20">
    
    <!-- Brand / Identity -->
    <a href="#" class="flex items-center gap-3 group focus:outline-none" aria-label="Dimaz Devriza - Halaman Utama">
      <div class="relative w-8 h-8 rounded-full bg-gradient-to-tr from-sky-500 to-blue-600 p-[1px] shadow-sm group-hover:scale-105 transition-transform">
        <div class="w-full h-full rounded-full bg-slate-950 flex items-center justify-center font-bold text-sky-400 text-xs">
          DD
        </div>
      </div>
      <div class="flex flex-col">
        <span class="font-bold text-sm tracking-tight text-white group-hover:text-sky-300 transition-colors">
          Dimaz Devriza
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 text-[13px] font-medium text-slate-300" aria-label="Navigasi Utama">
      <a href="#projects" class="px-3.5 py-1.5 rounded-full hover:text-white hover:bg-white/10 transition-all duration-300">
        Proyek
      </a>
      <a href="#skills" class="px-3.5 py-1.5 rounded-full hover:text-white hover:bg-white/10 transition-all duration-300">
        Keahlian
      </a>
      <a href="#certifications" class="px-3.5 py-1.5 rounded-full hover:text-white hover:bg-white/10 transition-all duration-300">
        Sertifikasi
      </a>
      <a href="#experience" class="px-3.5 py-1.5 rounded-full hover:text-white hover:bg-white/10 transition-all duration-300">
        Pengalaman
      </a>
      <a href="#contact" class="px-3.5 py-1.5 rounded-full hover:text-white hover:bg-white/10 transition-all duration-300">
        Kontak
      </a>
    </nav>

    <!-- Action Button: Nested Button-in-Button Architecture -->
    <div class="flex items-center gap-2">
      <a
        href={cvUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-apple group inline-flex items-center gap-2.5 text-xs font-semibold pl-4 pr-1.5 py-1.5 rounded-full bg-white text-slate-950 hover:bg-sky-100 shadow-md"
        aria-label="Unduh atau tinjau CV PDF di Google Drive"
      >
        <span>Lihat CV</span>
        <div class="w-6 h-6 rounded-full bg-slate-900/10 flex items-center justify-center group-hover:translate-x-0.5 transition-transform" aria-hidden="true">
          <svg class="w-3.5 h-3.5 text-slate-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </div>
      </a>

      <!-- Mobile Menu Toggle Button (Min 44px tap target) -->
      <button
        id="mobile-nav-toggle"
        class="md:hidden flex items-center justify-center w-11 h-11 rounded-full text-slate-300 hover:text-white hover:bg-white/10 focus:outline-none"
        aria-label="Buka menu navigasi"
        aria-expanded="false"
      >
        <svg class="w-5 h-5 menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-nav-menu"
    class="hidden md:hidden max-w-sm mx-auto mt-3 apple-glass-island rounded-3xl p-5 shadow-2xl flex flex-col gap-2 pointer-events-auto text-sm"
  >
    <a href="#projects" class="mobile-nav-link py-2.5 px-4 rounded-xl hover:bg-white/10 text-slate-200 font-medium">Proyek</a>
    <a href="#skills" class="mobile-nav-link py-2.5 px-4 rounded-xl hover:bg-white/10 text-slate-200 font-medium">Keahlian</a>
    <a href="#certifications" class="mobile-nav-link py-2.5 px-4 rounded-xl hover:bg-white/10 text-slate-200 font-medium">Sertifikasi</a>
    <a href="#experience" class="mobile-nav-link py-2.5 px-4 rounded-xl hover:bg-white/10 text-slate-200 font-medium">Pengalaman</a>
    <a href="#contact" class="mobile-nav-link py-2.5 px-4 rounded-xl hover:bg-white/10 text-slate-200 font-medium">Kontak</a>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-nav-toggle');
  const menu = document.getElementById('mobile-nav-menu');
  const links = document.querySelectorAll('.mobile-nav-link');

  if (toggleBtn && menu) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
    });

    links.forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
