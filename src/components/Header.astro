---
const cvUrl = "https://drive.google.com/file/d/1U_HjI-MsIsEdo688DzeY5v3SS33LWIAE/view?usp=sharing";
---

<header class="fixed top-5 inset-x-0 z-50 px-4 pointer-events-none">
  <div class="max-w-4xl mx-auto apple-glass-island rounded-full px-5 py-2.5 flex items-center justify-between pointer-events-auto transition-all duration-300">
    
    <!-- Brand / Identity -->
    <a href="#" class="flex items-center gap-3 group focus:outline-none" aria-label="Dimaz Devriza - Halaman Utama">
      <div class="relative w-8 h-8 rounded-full bg-gradient-to-tr from-sky-500 to-blue-600 p-[1px] shadow-sm group-hover:scale-105 transition-transform">
        <div class="w-full h-full rounded-full bg-slate-950 flex items-center justify-center font-bold text-sky-400 text-xs">
          DD
        </div>
      </div>
      <div class="flex flex-col">
        <span class="font-bold text-sm tracking-tight text-white dark:text-white light:text-slate-900 group-hover:text-sky-400 transition-colors">
          Dimaz Devriza
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 text-[13px] font-medium text-slate-300 dark:text-slate-300 light:text-slate-700" aria-label="Navigasi Utama">
      <a href="#projects" class="px-3.5 py-1.5 rounded-full hover:text-white dark:hover:text-white light:hover:text-slate-950 hover:bg-white/10 dark:hover:bg-white/10 light:hover:bg-slate-200/60 transition-all duration-200">
        Proyek
      </a>
      <a href="#skills" class="px-3.5 py-1.5 rounded-full hover:text-white dark:hover:text-white light:hover:text-slate-950 hover:bg-white/10 dark:hover:bg-white/10 light:hover:bg-slate-200/60 transition-all duration-200">
        Keahlian
      </a>
      <a href="#certifications" class="px-3.5 py-1.5 rounded-full hover:text-white dark:hover:text-white light:hover:text-slate-950 hover:bg-white/10 dark:hover:bg-white/10 light:hover:bg-slate-200/60 transition-all duration-200">
        Sertifikasi
      </a>
      <a href="#experience" class="px-3.5 py-1.5 rounded-full hover:text-white dark:hover:text-white light:hover:text-slate-950 hover:bg-white/10 dark:hover:bg-white/10 light:hover:bg-slate-200/60 transition-all duration-200">
        Pengalaman
      </a>
      <a href="#contact" class="px-3.5 py-1.5 rounded-full hover:text-white dark:hover:text-white light:hover:text-slate-950 hover:bg-white/10 dark:hover:bg-white/10 light:hover:bg-slate-200/60 transition-all duration-200">
        Kontak
      </a>
    </nav>

    <!-- Action Buttons -->
    <div class="flex items-center gap-2">
      
      <!-- Theme Toggle Button (Light/Dark R-21 / R-34) -->
      <button
        id="theme-toggle-btn"
        type="button"
        class="w-8 h-8 rounded-full flex items-center justify-center text-slate-300 dark:text-slate-300 light:text-slate-700 hover:text-white dark:hover:text-white light:hover:text-black bg-white/[0.06] dark:bg-white/[0.06] light:bg-black/[0.06] hover:bg-white/15 dark:hover:bg-white/15 light:hover:bg-black/15 border border-white/10 dark:border-white/10 light:border-black/10 transition-colors focus:outline-none"
        aria-label="Alihkan tema tampilan terang atau gelap"
      >
        <svg id="theme-sun-icon" class="w-4 h-4 hidden text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
        </svg>
        <svg id="theme-moon-icon" class="w-4 h-4 text-sky-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
        </svg>
      </button>

      <!-- CV CTA Button -->
      <a
        href={cvUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-apple group inline-flex items-center gap-2 text-xs font-semibold pl-3.5 pr-1.5 py-1.5 rounded-full bg-white text-slate-950 hover:bg-sky-50 shadow-md"
        aria-label="Unduh atau tinjau CV PDF di Google Drive"
      >
        <span>Lihat CV</span>
        <div class="w-6 h-6 rounded-full bg-slate-900/10 flex items-center justify-center group-hover:translate-x-0.5 transition-transform" aria-hidden="true">
          <svg class="w-3.5 h-3.5 text-slate-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </div>
      </a>

      <!-- Mobile Menu Toggle Button (Min 44px tap target) -->
      <button
        id="mobile-nav-toggle"
        class="md:hidden flex items-center justify-center w-11 h-11 rounded-full text-slate-300 hover:text-white hover:bg-white/10 focus:outline-none"
        aria-label="Buka menu navigasi"
        aria-expanded="false"
      >
        <svg class="w-5 h-5 menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-nav-menu"
    class="hidden md:hidden max-w-sm mx-auto mt-3 apple-glass-island rounded-3xl p-5 shadow-2xl flex flex-col gap-2 pointer-events-auto text-sm"
  >
    <a href="#projects" class="mobile-nav-link py-2.5 px-4 rounded-xl hover:bg-white/10 text-slate-200 font-medium">Proyek</a>
    <a href="#skills" class="mobile-nav-link py-2.5 px-4 rounded-xl hover:bg-white/10 text-slate-200 font-medium">Keahlian</a>
    <a href="#certifications" class="mobile-nav-link py-2.5 px-4 rounded-xl hover:bg-white/10 text-slate-200 font-medium">Sertifikasi</a>
    <a href="#experience" class="mobile-nav-link py-2.5 px-4 rounded-xl hover:bg-white/10 text-slate-200 font-medium">Pengalaman</a>
    <a href="#contact" class="mobile-nav-link py-2.5 px-4 rounded-xl hover:bg-white/10 text-slate-200 font-medium">Kontak</a>
  </div>
</header>

<script>
  // Mobile Nav Toggle
  const toggleBtn = document.getElementById('mobile-nav-toggle');
  const menu = document.getElementById('mobile-nav-menu');
  const links = document.querySelectorAll('.mobile-nav-link');

  if (toggleBtn && menu) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
    });

    links.forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }

  // Theme Toggle Logic
  const themeBtn = document.getElementById('theme-toggle-btn');
  const sunIcon = document.getElementById('theme-sun-icon');
  const moonIcon = document.getElementById('theme-moon-icon');

  const updateThemeIcons = () => {
    const isLight = document.documentElement.classList.contains('light');
    if (isLight) {
      sunIcon?.classList.remove('hidden');
      moonIcon?.classList.add('hidden');
    } else {
      sunIcon?.classList.add('hidden');
      moonIcon?.classList.remove('hidden');
    }
  };

  updateThemeIcons();

  themeBtn?.addEventListener('click', () => {
    const isLight = document.documentElement.classList.toggle('light');
    localStorage.setItem('theme', isLight ? 'light' : 'dark');
    updateThemeIcons();
  });
</script>
