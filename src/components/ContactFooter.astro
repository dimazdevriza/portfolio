---
const cvUrl = "https://drive.google.com/file/d/1U_HjI-MsIsEdo688DzeY5v3SS33LWIAE/view?usp=sharing";
const driveArchiveUrl = "https://drive.google.com/drive/folders/1K6PsKpArQAbXgFQS4QruEJD4zFDRoOUo?usp=sharing";
---

<footer id="contact" class="py-24 sm:py-32 border-t border-white/[0.06] light:border-slate-200 bg-slate-950/60 light:bg-slate-100/60 relative">
  <div class="max-w-6xl mx-auto px-6">
    
    <!-- Double-Bezel Contact Hero Card -->
    <div class="bezel-outer mb-16 reveal-on-scroll opacity-0 translate-y-8">
      <div class="bezel-inner p-8 sm:p-14 relative overflow-hidden">
        
        <!-- Ambient radial glow inside card -->
        <div class="absolute -top-24 -right-24 w-80 h-80 bg-sky-500/10 blur-[100px] rounded-full pointer-events-none" aria-hidden="true"></div>

        <div class="max-w-2xl relative z-10">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-8 h-[2px] bg-sky-400" aria-hidden="true"></span>
            <span class="text-xs uppercase tracking-[0.2em] font-semibold text-sky-400">Komunikasi Langsung</span>
          </div>
          
          <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white light:text-slate-900 mb-4 leading-tight">
            Mencari Web Developer yang Disiplin dan Teruji?
          </h2>
          
          <p class="text-slate-300 light:text-slate-700 text-base sm:text-lg leading-relaxed mb-10 font-normal">
            Terbuka untuk posisi Full-Stack Web Developer purnawaktu, konsultasi rekayasa sistem, dan pengembangan aplikasi skala produksi. Silakan pelajari CV saya atau hubungi kontak langsung di bawah.
          </p>

          <div class="flex flex-wrap items-center gap-4">
            <a
              href="mailto:dimaz.corn@gmail.com"
              class="btn-apple group inline-flex items-center gap-3 pl-6 pr-2 py-2 rounded-full bg-white dark:bg-white light:bg-slate-900 text-slate-950 dark:text-slate-950 light:text-white font-bold text-sm shadow-xl min-h-[48px]"
            >
              <span>Kirim Email (dimaz.corn@gmail.com)</span>
              <div class="w-8 h-8 rounded-full bg-slate-900/10 dark:bg-slate-900/10 light:bg-white/10 flex items-center justify-center group-hover:translate-x-0.5 transition-transform" aria-hidden="true">
                <svg class="w-4 h-4 text-slate-950 dark:text-slate-950 light:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </div>
            </a>

            <a
              href="https://wa.me/6289660807317"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-apple inline-flex items-center gap-2.5 px-6 py-3 rounded-full bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 light:text-emerald-700 border border-emerald-400/25 font-semibold text-sm shadow-sm min-h-[48px]"
            >
              <span>WhatsApp (+62 896-6080-7317)</span>
            </a>
          </div>
        </div>

      </div>
    </div>

    <!-- Bottom Navigation & Copyright -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6 pt-8 border-t border-white/[0.06] light:border-slate-200 text-xs text-slate-400 light:text-slate-600 font-medium">
      <div>
        <p>&copy; {new Date().getFullYear()} Dimaz Devriza. Padang, Sumatera Barat, Indonesia.</p>
      </div>

      <div class="flex flex-wrap items-center gap-6">
        <a href={cvUrl} target="_blank" rel="noopener noreferrer" class="hover:text-white light:hover:text-slate-900 transition-colors">
          Resume (Drive)
        </a>
        <a href={driveArchiveUrl} target="_blank" rel="noopener noreferrer" class="hover:text-white light:hover:text-slate-900 transition-colors">
          Sertifikat (Drive)
        </a>
        <a href="https://github.com/dimazdevriza" target="_blank" rel="noopener noreferrer" class="hover:text-white light:hover:text-slate-900 transition-colors">
          GitHub
        </a>
        <a href="#about" class="hover:text-white light:hover:text-slate-900 transition-colors">
          Kembali ke Atas &uarr;
        </a>
      </div>
    </div>

  </div>
</footer>
