---
const cvUrl = "https://drive.google.com/file/d/1KKT_Tqwmpti5bLdsz5CrOPW236-LqkUC/view?usp=sharing";
const driveArchiveUrl = "https://drive.google.com/drive/folders/1K6PsKpArQAbXgFQS4QruEJD4zFDRoOUo?usp=sharing";
---

<footer id="contact" class="py-24 border-t border-slate-800/80 bg-canvas relative">
  <div class="max-w-5xl mx-auto px-6">
    
    <!-- Kotak Hubungi Langsung dengan Garis Kaca -->
    <div class="p-8 sm:p-12 rounded-3xl bg-gradient-to-b from-slate-900/90 to-card border border-slate-700/60 shadow-2xl relative overflow-hidden mb-16 reveal-on-scroll opacity-0 translate-y-8">
      <div class="max-w-2xl">
        <span class="text-xs font-mono text-accent uppercase font-bold tracking-wider block mb-3">
          KOMUNIKASI LANGSUNG
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white mb-4">
          Mencari Web Developer yang Berpengalaman dan Disiplin?
        </h2>
        <p class="text-slate-300 text-sm leading-relaxed mb-8">
          Terbuka untuk posisi Full-Stack Web Developer purnawaktu, konsultasi teknis rekayasa sistem, dan implementasi aplikasi web skala produksi. Silakan pelajari CV saya atau hubungi kontak langsung di bawah.
        </p>

        <div class="flex flex-wrap items-center gap-4">
          <a
            href="mailto:dimaz.corn@gmail.com"
            class="tactile-btn inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-accent text-slate-950 font-bold text-sm hover:bg-sky-300 shadow-glow-accent min-h-[44px]"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <span>Kirim Email (dimaz.corn@gmail.com)</span>
          </a>

          <a
            href="https://wa.me/6289660807317"
            target="_blank"
            rel="noopener noreferrer"
            class="tactile-btn inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-emerald-600/20 text-emerald-300 border border-emerald-500/30 hover:bg-emerald-600/30 font-semibold text-sm min-h-[44px]"
          >
            <span>WhatsApp (+62 896-6080-7317)</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Metadata Bawah & Navigasi -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6 pt-8 border-t border-slate-800 text-xs font-mono text-slate-500">
      <div>
        <p>&copy; {new Date().getFullYear()} Dimaz Devriza. Padang, Sumatera Barat, Indonesia.</p>
      </div>

      <div class="flex flex-wrap items-center gap-6">
        <a href={cvUrl} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">
          Resume (Drive)
        </a>
        <a href={driveArchiveUrl} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">
          Sertifikat (Drive)
        </a>
        <a href="https://github.com/dimazdevriza" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">
          GitHub
        </a>
        <a href="#about" class="hover:text-accent transition-colors">
          Kembali ke Atas &uarr;
        </a>
      </div>
    </div>

  </div>
</footer>
