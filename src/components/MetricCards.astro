---
// Kredensial nyata dan terverifikasi
const metrics = [
  {
    title: "Akademik S1",
    value: "3,69",
    unit: "IPK",
    subtitle: "Teknologi Informasi, Universitas PGRI Sumatera Barat",
    tag: "Lulusan 2026",
    gradient: "from-sky-400 to-blue-500",
  },
  {
    title: "Sertifikasi Industri",
    value: "2",
    unit: "Lisensi",
    subtitle: "MikroTik MTCNA Jaringan & Microsoft Azure AI Fundamentals",
    tag: "Internasional",
    gradient: "from-blue-400 to-indigo-500",
  },
  {
    title: "Sistem Produksi",
    value: "3",
    unit: "Aplikasi",
    subtitle: "Sistem Logistik D'Royal Village, LMS SMAN 15, SiLAB LLDIKTI X",
    tag: "Klien & Instansi",
    gradient: "from-indigo-400 to-purple-500",
  },
  {
    title: "Standar Arsitektur",
    value: "ACID",
    unit: "Proteksi",
    subtitle: "Pessimistic locking database untuk mencegah race condition",
    tag: "Enterprise",
    gradient: "from-teal-400 to-sky-500",
  },
];
---

<section class="py-14 border-y border-white/[0.06] bg-slate-950/40 relative">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {metrics.map((item) => (
        <div class="bezel-outer p-1.5 reveal-on-scroll opacity-0 translate-y-8">
          <div class="bezel-inner p-5 flex flex-col justify-between h-full">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-semibold text-slate-400">{item.title}</span>
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-white/[0.05] text-slate-300 border border-white/[0.08]">
                  {item.tag}
                </span>
              </div>
              <div class="flex items-baseline gap-2 mb-2">
                <span class={`text-3xl sm:text-4xl font-extrabold tracking-tight bg-gradient-to-r ${item.gradient} bg-clip-text text-transparent`}>
                  {item.value}
                </span>
                <span class="text-xs font-semibold text-slate-400">{item.unit}</span>
              </div>
            </div>
            <p class="text-xs text-slate-400 leading-relaxed mt-2 font-normal">
              {item.subtitle}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
