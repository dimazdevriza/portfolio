---
// Kredensial nyata dan terverifikasi
const metrics = [
  {
    title: "Akademik S1",
    target: "3.69",
    display: "3,69",
    decimals: 2,
    unit: "IPK",
    subtitle: "Teknologi Informasi, Universitas PGRI Sumatera Barat",
    tag: "Lulusan 2026",
    gradient: "from-sky-400 to-blue-500",
  },
  {
    title: "Sertifikasi Industri",
    target: "2",
    display: "2",
    decimals: 0,
    unit: "Lisensi",
    subtitle: "MikroTik MTCNA Jaringan & Microsoft Azure AI Fundamentals",
    tag: "Internasional",
    gradient: "from-blue-400 to-indigo-500",
  },
  {
    title: "Pengalaman Proyek",
    target: "3",
    display: "3",
    decimals: 0,
    unit: "Aplikasi",
    subtitle: "Sistem Logistik D'Royal Village, LMS SMAN 15, Magang SiLAB LLDIKTI X",
    tag: "Klien & Instansi",
    gradient: "from-indigo-400 to-purple-500",
  },
];
---

<section id="metrics-bar" class="py-14 border-y border-white/[0.06] light:border-slate-200 bg-slate-950/40 light:bg-slate-100/50 relative">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
      {metrics.map((item) => (
        <div class="bezel-outer p-1.5 metric-card opacity-0 translate-y-8">
          <div class="bezel-inner p-5 flex flex-col justify-between h-full hover:border-white/[0.12] transition-colors">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-semibold text-slate-400 light:text-slate-600">{item.title}</span>
                <span class="px-2.5 py-0.5 rounded-md text-[11px] font-medium bg-white/[0.05] light:bg-slate-100 text-slate-300 light:text-slate-700 border border-white/[0.08] light:border-slate-300">
                  {item.tag}
                </span>
              </div>
              <div class="flex items-baseline gap-2 mb-2">
                {item.target ? (
                  <span
                    class={`metric-counter text-3xl sm:text-4xl font-extrabold tracking-tight bg-gradient-to-r ${item.gradient} bg-clip-text text-transparent`}
                    data-target={item.target}
                    data-decimals={item.decimals}
                  >
                    0
                  </span>
                ) : (
                  <span class={`text-3xl sm:text-4xl font-extrabold tracking-tight bg-gradient-to-r ${item.gradient} bg-clip-text text-transparent`}>
                    {item.display}
                  </span>
                )}
                <span class="text-xs font-semibold text-slate-400 light:text-slate-600">{item.unit}</span>
              </div>
            </div>
            <p class="text-xs text-slate-400 light:text-slate-600 leading-relaxed mt-2 font-normal">
              {item.subtitle}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
