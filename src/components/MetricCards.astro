---
// Bukti pencapaian nyata berdasarkan data CV dan ijazah resmi Dimaz Devriza
const metrics = [
  {
    title: "Prestasi Akademik S1",
    value: "3,69",
    unit: "IPK",
    subtitle: "Teknologi Informasi, Universitas PGRI Sumatera Barat",
    tag: "Kelulusan 2022 - 2026",
  },
  {
    title: "Sertifikasi Industri",
    value: "2",
    unit: "Teruji",
    subtitle: "MikroTik MTCNA (Jaringan Komputer) & Microsoft Azure AI Fundamentals",
    tag: "Standar Internasional",
  },
  {
    title: "Sistem Produksi",
    value: "3",
    unit: "Di-deploy",
    subtitle: "Sistem Logistik D'Royal Village, LMS SMAN 15 Padang, SiLAB LLDIKTI X",
    tag: "Aktif Beroperasi",
  },
  {
    title: "Standar Arsitektur",
    value: "ACID",
    unit: "Terproteksi",
    subtitle: "Pessimistic locking database untuk mencegah race condition stok",
    tag: "Aman Konkurensi",
  },
];
---

<section class="py-12 border-y border-slate-800/80 bg-canvas-subtle/50 relative">
  <div class="max-w-5xl mx-auto px-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {metrics.map((item) => (
        <div class="p-5 rounded-2xl bg-card border border-card-border hover:border-slate-700 transition-all duration-300 reveal-on-scroll opacity-0 translate-y-8 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-[11px] font-mono text-slate-400 uppercase tracking-wider">{item.title}</span>
              <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-slate-800 text-slate-300 border border-slate-700/50">
                {item.tag}
              </span>
            </div>
            <div class="flex items-baseline gap-1.5 mb-2">
              <span class="text-3xl font-extrabold tracking-tight text-white">{item.value}</span>
              <span class="text-xs font-semibold text-accent">{item.unit}</span>
            </div>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed mt-2">
            {item.subtitle}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
