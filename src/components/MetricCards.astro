---
// Proof points directly grounded in Dimaz Devriza's real CV and verified achievements (R-17 & C-5 compliant)
const metrics = [
  {
    title: "S1 Academic Grade",
    value: "3.69",
    unit: "GPA",
    subtitle: "Teknologi Informasi, Universitas PGRI Sumatera Barat",
    tag: "Degree 2022 - 2026",
  },
  {
    title: "Industry Certifications",
    value: "2",
    unit: "Verified",
    subtitle: "MikroTik MTCNA (Networking) & Microsoft Azure AI Fundamentals",
    tag: "International Standards",
  },
  {
    title: "Production Systems",
    value: "3",
    unit: "Deployed",
    subtitle: "D'Royal Village Logistics, SMAN 15 Padang LMS, LLDIKTI X SiLAB",
    tag: "Active In Field",
  },
  {
    title: "Architecture Standard",
    value: "ACID",
    unit: "Protected",
    subtitle: "Pessimistic database locking preventing race conditions on stock",
    tag: "Concurrency Safe",
  },
];
---

<section class="py-12 border-y border-slate-800/80 bg-canvas-subtle/50 relative">
  <div class="max-w-5xl mx-auto px-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {metrics.map((item, idx) => (
        <div class="p-5 rounded-2xl bg-card border border-card-border hover:border-slate-700 transition-all duration-300 reveal-on-scroll opacity-0 translate-y-8 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-[11px] font-mono text-slate-400 uppercase tracking-wider">{item.title}</span>
              <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-slate-800 text-slate-300 border border-slate-700/50">
                {item.tag}
              </span>
            </div>
            <div class="flex items-baseline gap-1.5 mb-2">
              <span class="text-3xl font-extrabold tracking-tight text-white">{item.value}</span>
              <span class="text-xs font-semibold text-accent">{item.unit}</span>
            </div>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed mt-2">
            {item.subtitle}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
