---
const timeline = [
  {
    period: "Jan 2026 - Oct 2026",
    role: "Web Developer",
    organization: "D'Royal Village",
    location: "Padang, West Sumatra",
    type: "Enterprise System",
    summary: "Built and deployed an integrated logistics and project cost-control web platform for housing developments. Eliminated manual spreadsheets with batch-price stock tracking, unit cost billing, tool loan management, and ACID transaction safety.",
    stack: ["Laravel", "Livewire", "Alpine.js", "MySQL", "Tailwind CSS"],
  },
  {
    period: "Mar 2026 - Jul 2026",
    role: "Web Developer",
    organization: "SMA Negeri 15 Padang",
    location: "Padang, West Sumatra",
    type: "Education Platform",
    summary: "Co-developed and deployed a production Learning Management System (LMS) for high school teachers and students. Configured live hosting infrastructure with Git deployment workflows.",
    stack: ["Laravel", "PHP", "MySQL", "Git", "cPanel Deployment"],
  },
  {
    period: "Jun 2025 - Oct 2025",
    role: "Web Developer Intern",
    organization: "LLDIKTI Wilayah X",
    location: "Padang, West Sumatra",
    type: "Government Agency",
    summary: "Maintained, upgraded, and optimized the SiLAB laboratory booking platform. Enhanced user registration pipelines, document compliance verification, and administrative review workflows.",
    stack: ["PHP Native", "MySQL", "Bootstrap", "Relational Schema"],
  },
  {
    period: "2022 - 2026",
    role: "S1 Teknologi Informasi (GPA 3.69)",
    organization: "Universitas PGRI Sumatera Barat",
    location: "Padang, West Sumatra",
    type: "Academic Degree",
    summary: "Graduated with honors (IPK 3.69). Completed coursework in software engineering, database design, computer networks, and artificial intelligence fundamentals.",
    stack: ["Software Engineering", "Computer Networks", "Database Architecture"],
  },
];
---

<section id="experience" class="py-24 bg-canvas-subtle/30 border-t border-slate-800/80 relative">
  <div class="max-w-5xl mx-auto px-6">
    
    <div class="mb-16 reveal-on-scroll opacity-0 translate-y-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-800/80 border border-slate-700/60 text-xs font-mono text-accent mb-3">
        <span>CAREER & EDUCATION</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white mb-2">
        Work History & Education
      </h2>
      <p class="text-slate-400 text-sm max-w-xl">
        Chronological record of software development roles, internships, and formal university studies.
      </p>
    </div>

    <!-- Timeline List -->
    <div class="relative pl-6 sm:pl-8 border-l border-slate-800 space-y-12">
      {timeline.map((item, idx) => (
        <div class="relative reveal-on-scroll opacity-0 translate-y-8">
          <!-- Timeline Marker Point -->
          <div class="absolute -left-[31px] sm:-left-[39px] top-1.5 w-3.5 h-3.5 rounded-full bg-canvas border-2 border-accent" aria-hidden="true"></div>

          <div class="p-6 rounded-2xl bg-card border border-card-border hover:border-slate-700 transition-colors">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
              <span class="text-xs font-mono font-bold text-accent">{item.period}</span>
              <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-slate-800 text-slate-300 border border-slate-700/50">
                {item.type}
              </span>
            </div>

            <h3 class="text-lg font-bold text-white mb-1">
              {item.role} <span class="text-slate-400 font-normal">at {item.organization}</span>
            </h3>
            
            <p class="text-xs font-mono text-slate-500 mb-3">
              {item.location}
            </p>

            <p class="text-xs text-slate-300 leading-relaxed mb-4">
              {item.summary}
            </p>

            <div class="flex flex-wrap gap-1.5">
              {item.stack.map((tech) => (
                <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-slate-900 text-slate-400 border border-slate-800">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
