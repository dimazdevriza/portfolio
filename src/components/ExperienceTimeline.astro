---
const timeline = [
  {
    period: "Januari 2026 - Oktober 2026",
    role: "Web Developer",
    organization: "D'Royal Village",
    location: "Kota Padang, Sumatera Barat",
    type: "Proyek Klien Komersial",
    summary: "Mengambil posisi sebagai software developer untuk perusahaan developer perumahan D'Royal Village dalam pengembangan Sistem Informasi Logistik terpadu dan pengendalian biaya proyek. Berhasil menggantikan operasional manual dan Excel dengan pelacakan stok material berbasis batch harga, pembebanan biaya unit rumah, peminjaman alat kerja, serta proteksi transaksi database ACID.",
    stack: ["Laravel 11", "Livewire 3", "Alpine.js", "MySQL", "Tailwind CSS"],
  },
  {
    period: "Maret 2026 - Juli 2026",
    role: "Web Developer",
    organization: "SMA Negeri 15 Padang",
    location: "Kota Padang, Sumatera Barat",
    type: "Platform Pendidikan",
    summary: "Bekerja sebagai Web Developer bersama satu rekan pengembang dalam pengembangan Learning Management System (LMS) untuk SMA Negeri 15 Padang. Sistem ini sukses diciptakan, di-deploy menggunakan Git di hosting Rumahweb, dan digunakan secara aktif oleh pihak sekolah.",
    stack: ["Laravel", "PHP", "MySQL", "Git", "Hosting Rumahweb"],
  },
  {
    period: "Juni 2025 - Oktober 2025",
    role: "Web Developer Intern",
    organization: "LLDIKTI Wilayah X",
    location: "Kota Padang, Sumatera Barat",
    type: "Program Magang (Internship)",
    summary: "Melaksanakan program magang di Kantor LLDIKTI Wilayah X dengan tugas memelihara, memperbaiki, dan mengembangkan Sistem Informasi Pembookingan Pemakaian Laboratorium (SiLAB). Menyempurnakan pendaftaran pengguna, validasi berkas persyaratan, serta verifikasi pemesanan oleh admin.",
    stack: ["PHP Native", "MySQL", "Bootstrap", "Database Relasional"],
  },
  {
    period: "2022 - 2026",
    role: "S1 Teknologi Informasi (IPK 3,69)",
    organization: "Universitas PGRI Sumatera Barat",
    location: "Kota Padang, Sumatera Barat",
    type: "Pendidikan Formal",
    summary: "Lulus dengan predikat sangat memuaskan (IPK 3,69). Mempelajari rekayasa perangkat lunak, arsitektur basis data, jaringan komputer, dan dasar-dasar kecerdasan buatan.",
    stack: ["Rekayasa Perangkat Lunak", "Jaringan Komputer", "Basis Data"],
  },
];
---

<section id="experience" class="py-24 sm:py-32 border-t border-white/[0.06] light:border-slate-200 relative">
  <div class="max-w-6xl mx-auto px-6">
    
    <!-- Section Header (Clean Authoritative Title R-09 / R-05) -->
    <div class="mb-16 reveal-on-scroll opacity-0 translate-y-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="w-8 h-[2px] bg-sky-400" aria-hidden="true"></span>
        <span class="text-xs uppercase tracking-[0.2em] font-semibold text-sky-400">Rekam Jejak</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white light:text-slate-900 mb-4">
        Pengalaman Kerja & Pendidikan
      </h2>
      <p class="text-slate-300 light:text-slate-700 text-base sm:text-lg max-w-2xl leading-relaxed font-normal">
        Catatan riwayat kerja profesional, proyek implementasi sistem nyata, dan latar belakang akademik formal.
      </p>
    </div>

    <!-- Timeline List with Nodes -->
    <div class="relative pl-6 sm:pl-10 border-l border-white/[0.1] light:border-slate-300 space-y-12">
      {timeline.map((item) => (
        <div class="relative reveal-on-scroll opacity-0 translate-y-8">
          
          <!-- Node -->
          <div class="absolute -left-[31px] sm:-left-[47px] top-6 w-3.5 h-3.5 rounded-full bg-slate-950 light:bg-white border-2 border-sky-400 shadow-[0_0_10px_rgba(56,189,248,0.7)]" aria-hidden="true"></div>

          <div class="bezel-outer">
            <div class="bezel-inner p-6 sm:p-8">
              <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
                <span class="text-xs font-semibold text-sky-400 light:text-sky-600">{item.period}</span>
                <span class="px-2.5 py-0.5 rounded-md text-xs font-medium bg-white/[0.04] light:bg-slate-100 text-slate-300 light:text-slate-700 border border-white/[0.08] light:border-slate-300">
                  {item.type}
                </span>
              </div>

              <h3 class="text-xl font-bold text-white light:text-slate-900 mb-1.5">
                {item.role} <span class="text-slate-400 light:text-slate-500 font-normal">di {item.organization}</span>
              </h3>
              
              <p class="text-xs font-medium text-slate-400 light:text-slate-500 mb-4">
                {item.location}
              </p>

              <p class="text-xs sm:text-sm text-slate-300 light:text-slate-700 leading-relaxed mb-6 font-normal">
                {item.summary}
              </p>

              <div class="flex flex-wrap gap-2">
                {item.stack.map((tech) => (
                  <span class="px-2.5 py-1 rounded-md text-xs font-medium bg-white/[0.03] light:bg-slate-100 text-slate-300 light:text-slate-700 border border-white/[0.06] light:border-slate-200">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
