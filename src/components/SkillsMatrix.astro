---
const skillGroups = [
  {
    category: "Pengembangan Web Full-Stack",
    description: "Aplikasi web skala produksi yang dibangun dengan arsitektur bersih dan pola UI reaktif.",
    skills: [
      { name: "Laravel", level: "Framework Utama", note: "Eloquent ORM, Migrasi, Otorisasi RBAC, Auth" },
      { name: "Livewire & Alpine.js", level: "Reaktivitas Frontend", note: "Interaksi real-time tanpa reload dan dynamic DOM" },
      { name: "PHP", level: "Bahasa Pemrograman", note: "OOP Modern, Strict Typing, RESTful API" },
      { name: "MySQL", level: "Basis Data Relasional", note: "Transaksi ACID, Indexing, Pessimistic Locking" },
      { name: "Tailwind CSS", level: "Desain Tampilan", note: "Desain responsif, sistem komponen modern" },
      { name: "REST API & JSON", level: "Integrasi Layanan", note: "Arsitektur endpoint bersih dan validasi data" },
    ],
  },
  {
    category: "Jaringan Komputer & Infrastruktur",
    description: "Konfigurasi routing bersertifikasi internasional, manajemen server, dan deployment sistem.",
    skills: [
      { name: "MikroTik RouterOS", level: "Tersertifikasi (MTCNA)", note: "Routing, NAT, Firewall Filtering, Manajemen Bandwidth" },
      { name: "Jaringan Komputer", level: "Infrastruktur Inti", note: "TCP/IP, Subnetting, DNS, Gateway, Troubleshooting" },
      { name: "Git & Version Control", level: "Alur Kolaborasi", note: "Feature branching, manajemen commit, merge workflow" },
      { name: "Deployment Server", level: "Operasional Hosting", note: "cPanel, Hosting Rumahweb, SSL, Domain & DNS" },
      { name: "Microsoft Azure AI", level: "Fondasi AI Cloud", note: "Konsep dasar machine learning dan integrasi AI" },
      { name: "Software QA & Testing", level: "Kualitas Kode", note: "Pemeriksaan bug, validasi edge-cases, verifikasi alur" },
    ],
  },
];
---

<section id="skills" class="py-24 relative">
  <div class="max-w-5xl mx-auto px-6">
    
    <div class="mb-16 reveal-on-scroll opacity-0 translate-y-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-800/80 border border-slate-700/60 text-xs font-mono text-accent mb-3">
        <span>FONDASI TEKNIS</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white mb-2">
        Keahlian & Penguasaan Teknologi
      </h2>
      <p class="text-slate-400 text-sm max-w-xl">
        Kombinasi solid antara pengembangan sistem aplikasi web full-stack dan rekayasa infrastruktur jaringan komputer.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {skillGroups.map((group) => (
        <div class="p-6 sm:p-8 rounded-3xl bg-card border border-card-border hover:border-slate-700 transition-all duration-300 reveal-on-scroll opacity-0 translate-y-8">
          <div class="mb-6">
            <h3 class="text-xl font-bold text-white mb-1 tracking-tight">
              {group.category}
            </h3>
            <p class="text-xs text-slate-400">
              {group.description}
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {group.skills.map((skill) => (
              <div class="p-3 rounded-xl bg-slate-900/90 border border-slate-800/80 hover:border-slate-700 transition-colors">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-xs font-bold text-slate-200">{skill.name}</span>
                  <span class="text-[10px] font-mono text-accent font-semibold">{skill.level}</span>
                </div>
                <p class="text-[11px] text-slate-400 leading-tight">
                  {skill.note}
                </p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
