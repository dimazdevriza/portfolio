---
const skillGroups = [
  {
    category: "Pengembangan Web Full-Stack",
    description: "Arsitektur web modern skala produksi dengan fokus pada performa, keamanan, dan reaktivitas.",
    skills: [
      { name: "Laravel", level: "Framework Utama", note: "Eloquent ORM, Migrasi, Otorisasi RBAC, Queue" },
      { name: "Livewire & Alpine.js", level: "UI Reaktif", note: "Interaksi real-time tanpa reload dan dynamic state" },
      { name: "PHP", level: "Bahasa Inti", note: "Modern OOP, Strict Typing, RESTful Architecture" },
      { name: "MySQL", level: "Database Relasional", note: "Transaksi ACID, Indexing, Pessimistic Locking" },
      { name: "Tailwind CSS", level: "Styling & UI", note: "Desain sistem modern, tampilan mobile-first" },
      { name: "REST API & JSON", level: "Integrasi Layanan", note: "Desain endpoint bersih dan payload validation" },
    ],
  },
  {
    category: "Jaringan Komputer & Infrastruktur",
    description: "Sertifikasi routing internasional, konfigurasi server, dan deployment sistem berkelanjutan.",
    skills: [
      { name: "MikroTik RouterOS", level: "Tersertifikasi MTCNA", note: "Routing, NAT, Firewall Filtering, Bandwidth Queue" },
      { name: "Jaringan Komputer", level: "Infrastruktur", note: "TCP/IP, Subnetting, DNS, Gateway, Diagnostics" },
      { name: "Git & Version Control", level: "Alur Kerja", note: "Branching, Conflict Resolution, PR Workflow" },
      { name: "Deployment Server", level: "Operasional Hosting", note: "cPanel, Hosting Rumahweb, SSL, DNS Records" },
      { name: "Microsoft Azure AI", level: "Fondasi AI Cloud", note: "Konsep machine learning dan penerapan AI modern" },
      { name: "Software QA & Testing", level: "Penjaminan Kualitas", note: "Pest & PHPUnit test harness untuk validasi logika" },
    ],
  },
];
---

<section id="skills" class="py-24 sm:py-32 relative">
  <div class="max-w-6xl mx-auto px-6">
    
    <!-- Section Header (Clean Authoritative Title R-09 / R-05) -->
    <div class="mb-16 reveal-on-scroll opacity-0 translate-y-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="w-8 h-[2px] bg-sky-400" aria-hidden="true"></span>
        <span class="text-xs uppercase tracking-[0.2em] font-semibold text-sky-400">Fondasi Kompetensi</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white light:text-slate-900 mb-4">
        Keahlian & Kemampuan Teknis
      </h2>
      <p class="text-slate-300 light:text-slate-700 text-base sm:text-lg max-w-2xl leading-relaxed font-normal">
        Fondasi menyeluruh yang menggabungkan rekayasa aplikasi web tingkat lanjut dengan sertifikasi jaringan komputer dan infrastruktur cloud.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {skillGroups.map((group) => (
        <div class="bezel-outer reveal-on-scroll opacity-0 translate-y-8">
          <div class="bezel-inner p-6 sm:p-8 h-full flex flex-col justify-between">
            <div class="mb-6">
              <h3 class="text-xl sm:text-2xl font-bold text-white light:text-slate-900 mb-2 tracking-tight">
                {group.category}
              </h3>
              <p class="text-xs sm:text-sm text-slate-400 light:text-slate-600 leading-relaxed font-normal">
                {group.description}
              </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              {group.skills.map((skill) => (
                <div class="p-4 rounded-xl bg-white/[0.02] light:bg-slate-50 border border-white/[0.06] light:border-slate-200 hover:border-white/[0.15] transition-colors">
                  <div class="flex items-center justify-between mb-1.5">
                    <span class="text-sm font-bold text-slate-100 light:text-slate-900">{skill.name}</span>
                    <span class="text-[11px] font-semibold text-sky-400 light:text-sky-600">{skill.level}</span>
                  </div>
                  <p class="text-xs text-slate-400 light:text-slate-600 leading-relaxed">
                    {skill.note}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
