---
// Ribbon marquee menampilkan kapabilitas teknis terverifikasi
const items = [
  "Laravel 11",
  "Livewire 3",
  "MySQL ACID Transactions",
  "MikroTik MTCNA",
  "Microsoft Azure AI",
  "Alpine.js",
  "Tailwind CSS",
  "154 Pengujian Otomatis",
  "Pessimistic Database Locking",
  "Git Automated Deployments",
  "RESTful API & Webhooks",
  "UPGRISBA IPK 3,69",
];
---

<div class="py-6 border-y border-white/[0.08] bg-slate-950/60 backdrop-blur-md relative overflow-hidden select-none" aria-label="Ringkasan Kapabilitas Teknis">
  <!-- Gradient fade edges -->
  <div class="pointer-events-none absolute left-0 inset-y-0 w-24 bg-gradient-to-r from-[#030712] to-transparent z-10" aria-hidden="true"></div>
  <div class="pointer-events-none absolute right-0 inset-y-0 w-24 bg-gradient-to-l from-[#030712] to-transparent z-10" aria-hidden="true"></div>

  <div class="animate-marquee flex items-center gap-10 whitespace-nowrap">
    {items.concat(items).map((tech) => (
      <div class="inline-flex items-center gap-3 text-xs uppercase tracking-[0.18em] font-semibold text-slate-300 hover:text-sky-300 transition-colors">
        <span class="w-1.5 h-1.5 rounded-full bg-sky-400 shadow-[0_0_8px_rgba(56,189,248,0.8)]" aria-hidden="true"></span>
        <span>{tech}</span>
      </div>
    ))}
  </div>
</div>
