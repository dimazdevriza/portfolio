---
const cvUrl = "https://drive.google.com/file/d/1KKT_Tqwmpti5bLdsz5CrOPW236-LqkUC/view?usp=sharing";
---

<section id="about" class="relative pt-36 pb-24 md:pt-48 md:pb-36 overflow-hidden">
  <!-- Glowing ambient light orbs (Apple Pro atmosphere) -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-sky-500/10 blur-[130px] rounded-full pointer-events-none -z-10" aria-hidden="true"></div>
  <div class="absolute top-1/3 right-1/4 w-[400px] h-[300px] bg-blue-600/10 blur-[140px] rounded-full pointer-events-none -z-10" aria-hidden="true"></div>

  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Kolom Kiri: Typographic Headline & Proposition -->
      <div class="lg:col-span-7 flex flex-col items-start animate-apple-reveal">
        
        <!-- Status Indicator: Sleek Floating Glass Pill -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.1] backdrop-blur-md text-xs font-medium text-slate-300 mb-6 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.8)]"></span>
          <span>Terbuka untuk Peluang Full-Stack Developer</span>
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight mb-4 leading-[1.05]">
          <span class="shimmer-text">Dimaz Devriza</span>
        </h1>

        <p class="text-xl sm:text-2xl font-bold mb-6 tracking-tight accent-text-glow">
          Full-Stack Web Developer & Network Associate
        </p>

        <p class="text-slate-300 text-base sm:text-lg leading-relaxed mb-10 max-w-xl font-normal">
          Lulusan S1 Teknologi Informasi (UPGRISBA, IPK 3,69) dengan rekam jejak membangun dan men-deploy sistem web komersial menggunakan Laravel, Livewire, Alpine.js, dan MySQL. Berfokus pada integritas database transaksi ACID, penanganan konkurensi multi-gudang, serta deployment server berbasis Git.
        </p>

        <!-- CTAs: Apple Button Architecture -->
        <div class="flex flex-wrap items-center gap-4 w-full sm:w-auto mb-10">
          <a
            href="#projects"
            class="btn-apple group inline-flex items-center justify-between gap-4 pl-6 pr-2 py-2 rounded-full bg-white text-slate-950 font-bold text-sm shadow-xl min-h-[48px]"
          >
            <span>Eksplorasi Proyek Klien</span>
            <div class="w-8 h-8 rounded-full bg-slate-900/10 flex items-center justify-center group-hover:translate-x-0.5 transition-transform" aria-hidden="true">
              <svg class="w-4 h-4 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
              </svg>
            </div>
          </a>

          <a
            href={cvUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-apple group inline-flex items-center justify-between gap-3 px-6 py-3 rounded-full bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.12] text-slate-200 font-semibold text-sm backdrop-blur-md min-h-[48px]"
          >
            <span>Tinjau CV (Google Drive)</span>
            <svg class="w-4 h-4 text-slate-400 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
            </svg>
          </a>
        </div>

        <!-- Quick Info Ribbon -->
        <div class="flex flex-wrap items-center gap-6 text-xs text-slate-400">
          <span class="inline-flex items-center gap-2">
            <svg class="w-4 h-4 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            Padang, Sumatera Barat
          </span>
          <span class="w-1 h-1 rounded-full bg-slate-700" aria-hidden="true"></span>
          <a href="mailto:dimaz.corn@gmail.com" class="hover:text-sky-300 transition-colors">
            dimaz.corn@gmail.com
          </a>
        </div>
      </div>

      <!-- Kolom Kanan: Double-Bezel Hardware Frame Portrait Card -->
      <div class="lg:col-span-5 flex justify-center animate-apple-reveal [animation-delay:200ms]">
        <div class="relative group">
          
          <!-- Outer Machined Double-Bezel Shell -->
          <div class="bezel-outer w-[290px] sm:w-[330px]">
            <div class="bezel-inner p-3 relative overflow-hidden">
              
              <!-- Portrait Image Container with subtle inner bevel -->
              <div class="aspect-[3/4] rounded-2xl overflow-hidden bg-slate-950 relative shadow-inner">
                <img
                  src="./images/dimaz-devriza.jpg"
                  alt="Foto Profil Dimaz Devriza, Full-Stack Web Developer"
                  width="330"
                  height="440"
                  fetchpriority="high"
                  class="w-full h-full object-cover object-top filter brightness-[1.03] contrast-[1.02] group-hover:scale-[1.02] transition-transform duration-700"
                />
              </div>

              <!-- Sleek Floating Glass Badge (No dork monospace!) -->
              <div class="mt-3.5 p-3 rounded-2xl bg-white/[0.04] border border-white/[0.08] backdrop-blur-xl flex flex-col gap-2">
                <div class="flex items-center justify-between text-xs">
                  <span class="font-semibold text-slate-300">Kredensial Profesional</span>
                  <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-400">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    Terverifikasi
                  </span>
                </div>
                <div class="flex flex-wrap gap-1.5 text-[11px] font-medium text-slate-200">
                  <span class="px-2.5 py-1 rounded-lg bg-sky-500/15 text-sky-300 border border-sky-400/20">
                    MikroTik MTCNA
                  </span>
                  <span class="px-2.5 py-1 rounded-lg bg-blue-500/15 text-blue-300 border border-blue-400/20">
                    Azure AI
                  </span>
                  <span class="px-2.5 py-1 rounded-lg bg-indigo-500/15 text-indigo-300 border border-indigo-400/20">
                    S1 IPK 3,69
                  </span>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
