---
const cvUrl = "https://drive.google.com/file/d/1KKT_Tqwmpti5bLdsz5CrOPW236-LqkUC/view?usp=sharing";
---

<section id="about" class="relative pt-32 pb-20 md:pt-44 md:pb-28 overflow-hidden">
  <!-- Glowing ambient light orbs with breathing aura -->
  <div class="ambient-orb absolute top-1/4 left-1/3 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-sky-500/18 blur-[150px] rounded-full pointer-events-none -z-10 animate-pulse-aura" aria-hidden="true"></div>
  <div class="ambient-orb absolute top-1/3 right-1/4 w-[500px] h-[400px] bg-indigo-600/15 blur-[160px] rounded-full pointer-events-none -z-10 animate-pulse-aura" style="animation-delay: 2.5s;" aria-hidden="true"></div>

  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Kolom Kiri: Typographic Headline & Proposition -->
      <div class="lg:col-span-7 flex flex-col items-start z-10">
        
        <!-- Status Indicator: Sleek Floating Glass Pill with Dual Radar Pulse -->
        <div id="hero-status" class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-white/[0.04] border border-white/[0.12] backdrop-blur-xl text-xs font-medium text-slate-200 mb-6 shadow-lg hover:border-sky-400/50 hover:bg-white/[0.08] transition-all cursor-default">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-400"></span>
          </span>
          <span class="tracking-wide">Terbuka untuk Peluang Full-Stack Developer</span>
        </div>

        <!-- Master Headline with Split Kinematics Mask -->
        <h1 id="hero-title" class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight mb-4 leading-[1.08]">
          <span class="inline-block overflow-hidden mr-3">
            <span class="title-token inline-block shimmer-text">Dimaz</span>
          </span>
          <span class="inline-block overflow-hidden">
            <span class="title-token inline-block shimmer-text">Devriza</span>
          </span>
        </h1>

        <!-- Subtitle with Glowing Accent Gradient -->
        <p id="hero-subtitle" class="text-xl sm:text-2xl font-bold mb-6 tracking-tight accent-text-glow leading-snug">
          Full-Stack Web Developer & Network Associate
        </p>

        <!-- Technical Proposition Paragraph -->
        <p id="hero-bio" class="text-slate-300 text-base sm:text-lg leading-relaxed mb-10 max-w-xl font-normal">
          Lulusan S1 Teknologi Informasi (UPGRISBA, IPK 3,69) dengan rekam jejak membangun dan men-deploy sistem web komersial menggunakan Laravel, Livewire, Alpine.js, dan MySQL. Berfokus pada integritas database transaksi ACID, penanganan konkurensi multi-gudang, serta deployment server berbasis Git.
        </p>

        <!-- CTAs: Apple Button Architecture with Magnetic Physics -->
        <div id="hero-cta" class="flex flex-wrap items-center gap-4 w-full sm:w-auto mb-10">
          <a
            href="#projects"
            class="magnetic-btn btn-apple group inline-flex items-center justify-between gap-4 pl-6 pr-2 py-2 rounded-full bg-white text-slate-950 font-bold text-sm shadow-[0_10px_30px_-5px_rgba(255,255,255,0.3)] hover:shadow-[0_15px_35px_-5px_rgba(56,189,248,0.5)] min-h-[50px]"
          >
            <span class="tracking-tight">Eksplorasi Proyek Klien</span>
            <div class="w-8 h-8 rounded-full bg-slate-950/10 flex items-center justify-center group-hover:translate-x-1 group-hover:scale-110 transition-transform duration-300" aria-hidden="true">
              <svg class="w-4 h-4 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
              </svg>
            </div>
          </a>

          <a
            href={cvUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="magnetic-btn btn-apple group inline-flex items-center justify-between gap-3 px-6 py-3 rounded-full bg-white/[0.05] hover:bg-white/[0.12] border border-white/[0.14] hover:border-sky-400/40 text-slate-100 font-semibold text-sm backdrop-blur-xl shadow-lg min-h-[50px]"
          >
            <span>Tinjau CV (Google Drive)</span>
            <div class="w-6 h-6 rounded-full bg-white/[0.08] flex items-center justify-center group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" aria-hidden="true">
              <svg class="w-3.5 h-3.5 text-slate-300 group-hover:text-sky-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
              </svg>
            </div>
          </a>
        </div>

        <!-- Quick Info Ribbon -->
        <div id="hero-meta" class="flex flex-wrap items-center gap-6 text-xs text-slate-400">
          <span class="inline-flex items-center gap-2">
            <svg class="w-4 h-4 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            Padang, Sumatera Barat
          </span>
          <span class="w-1 h-1 rounded-full bg-slate-700" aria-hidden="true"></span>
          <a href="mailto:dimaz.corn@gmail.com" class="hover:text-sky-300 transition-colors flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            dimaz.corn@gmail.com
          </a>
          <span class="w-1 h-1 rounded-full bg-slate-700" aria-hidden="true"></span>
          <span class="text-slate-400">
            S1 IPK 3,69
          </span>
        </div>
      </div>

      <!-- Kolom Kanan: Machined Hardware Identity Module with 3D Gyroscope -->
      <div class="lg:col-span-5 flex justify-center z-10">
        <div id="hero-card-container" class="perspective-1000 relative">
          
          <!-- Animated Backlit Glow Aura -->
          <div class="absolute -inset-4 bg-gradient-to-tr from-sky-500/25 via-blue-600/20 to-indigo-600/25 rounded-[3rem] blur-2xl opacity-70 pointer-events-none -z-10 animate-pulse-aura" aria-hidden="true"></div>

          <!-- Floating Overlapping Badge 1: Top-Right Status Chip -->
          <div id="card-badge-status" class="absolute -top-3 -right-3 sm:-right-4 z-20 px-3.5 py-1.5 rounded-full bg-slate-950/90 border border-white/15 backdrop-blur-xl shadow-2xl flex items-center gap-2 pointer-events-none animate-float-gentle">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
            </span>
            <span class="text-[11px] font-semibold text-slate-200">Status: Siap Bekerja</span>
          </div>

          <!-- Floating Overlapping Badge 2: Bottom-Left Core Stack Pill -->
          <div id="card-badge-metric" class="absolute -bottom-4 -left-3 sm:-left-4 z-20 px-4 py-2 rounded-2xl bg-slate-950/95 border border-sky-400/30 backdrop-blur-xl shadow-2xl flex items-center gap-2.5 pointer-events-none animate-float-reverse">
            <div class="w-6 h-6 rounded-lg bg-sky-500/20 flex items-center justify-center text-sky-400">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
              </svg>
            </div>
            <div class="flex flex-col">
              <span class="text-[11px] font-bold text-white tracking-tight">Laravel & MySQL</span>
              <span class="text-[10px] text-slate-400">Full-Stack Development</span>
            </div>
          </div>

          <!-- Outer Machined Double-Bezel Shell -->
          <div id="hero-card" class="bezel-outer w-[295px] sm:w-[335px] will-change-transform shadow-[0_30px_70px_-15px_rgba(0,0,0,0.95)]">
            <div class="bezel-inner p-3 relative overflow-hidden">
              
              <!-- Shimmer light reflection layer (tracks cursor) -->
              <div id="card-shine" class="pointer-events-none absolute inset-0 bg-gradient-to-tr from-transparent via-white/[0.12] to-transparent opacity-0 transition-opacity duration-300 z-10" aria-hidden="true"></div>

              <!-- Portrait Image Container with subtle inner shadow vignette -->
              <div class="aspect-[3/4] rounded-2xl overflow-hidden bg-slate-950 relative shadow-inner ring-1 ring-white/10">
                <img
                  src="./images/dimaz-devriza.jpg"
                  alt="Foto Profil Dimaz Devriza, Full-Stack Web Developer"
                  width="335"
                  height="446"
                  fetchpriority="high"
                  class="w-full h-full object-cover object-top filter brightness-[1.02] contrast-[1.03] hover:scale-[1.03] transition-transform duration-700"
                />
                <!-- Subtle gradient overlay at bottom of photo -->
                <div class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-slate-950/80 to-transparent pointer-events-none" aria-hidden="true"></div>
              </div>

              <!-- Sleek Floating Glass Badge Bar -->
              <div class="mt-3.5 p-3 rounded-2xl bg-white/[0.04] border border-white/[0.08] backdrop-blur-xl flex flex-col gap-2">
                <div class="flex items-center justify-between text-xs">
                  <span class="font-semibold text-slate-300">Kredensial Profesional</span>
                  <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-emerald-400">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.8)]"></span>
                    Terverifikasi
                  </span>
                </div>
                <div class="flex flex-wrap gap-1.5 text-[11px] font-medium text-slate-200">
                  <span class="px-2.5 py-1 rounded-lg bg-sky-500/15 text-sky-300 border border-sky-400/20 hover:bg-sky-500/25 transition-colors cursor-default">
                    MikroTik MTCNA
                  </span>
                  <span class="px-2.5 py-1 rounded-lg bg-blue-500/15 text-blue-300 border border-blue-400/20 hover:bg-blue-500/25 transition-colors cursor-default">
                    Azure AI
                  </span>
                  <span class="px-2.5 py-1 rounded-lg bg-indigo-500/15 text-indigo-300 border border-indigo-400/20 hover:bg-indigo-500/25 transition-colors cursor-default">
                    S1 IPK 3,69
                  </span>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
