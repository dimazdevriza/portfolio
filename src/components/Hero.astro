---
const cvUrl = "https://drive.google.com/file/d/1KKT_Tqwmpti5bLdsz5CrOPW236-LqkUC/view?usp=sharing";
---

<section id="about" class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden">
  <!-- Aksen pendaran halus di belakang hero -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[300px] bg-sky-500/10 blur-[120px] rounded-full pointer-events-none -z-10" aria-hidden="true"></div>

  <div class="max-w-5xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Kolom Kiri: Profil & Kredensial -->
      <div class="lg:col-span-7 flex flex-col items-start animate-fluid-up">
        <!-- Status Indicator Pill -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-800/80 border border-slate-700/60 text-xs font-medium text-slate-300 mb-6">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Terbuka untuk Peluang Full-Stack Web Developer</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white mb-4 leading-[1.1]">
          Dimaz Devriza
        </h1>

        <p class="text-lg sm:text-xl font-semibold text-accent mb-6 tracking-wide">
          Full-Stack Web Developer & Network Associate
        </p>

        <p class="text-slate-300 text-base leading-relaxed mb-8 max-w-xl">
          Lulusan S1 Teknologi Informasi (UPGRISBA, IPK 3,69) dengan pengalaman langsung merancang, membangun, dan men-deploy sistem web produksi menggunakan Laravel, Livewire, Alpine.js, dan MySQL. Berfokus pada keamanan transaksi database ACID, penanganan konkurensi multi-gudang, serta deployment server berbasis Git.
        </p>

        <!-- CTA Button Group -->
        <div class="flex flex-wrap items-center gap-4 w-full sm:w-auto mb-8">
          <a
            href="#case-studies"
            class="tactile-btn inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-accent text-slate-950 font-bold text-sm hover:bg-sky-300 shadow-glow-accent min-h-[44px]"
          >
            <span>Lihat Proyek Klien</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
            </svg>
          </a>

          <a
            href={cvUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="tactile-btn inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-card border border-slate-700 text-slate-200 font-semibold text-sm hover:bg-slate-800 hover:border-slate-600 min-h-[44px]"
          >
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            <span>Lihat CV (Google Drive)</span>
          </a>
        </div>

        <!-- Lokasi & Kontak Cepat -->
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs font-mono text-slate-400">
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            Padang, Sumatera Barat, Indonesia
          </span>
          <a href="mailto:dimaz.corn@gmail.com" class="hover:text-accent transition-colors underline-offset-4 hover:underline">
            dimaz.corn@gmail.com
          </a>
        </div>
      </div>

      <!-- Kolom Kanan: Kartu Foto Bergaya Apple Glass -->
      <div class="lg:col-span-5 flex justify-center animate-fluid-up [animation-delay:150ms]">
        <div class="relative group">
          <!-- Glass Card Container -->
          <div class="relative w-[280px] sm:w-[320px] rounded-3xl p-3 bg-gradient-to-b from-slate-800/60 to-slate-900/90 border border-slate-700/60 shadow-2xl overflow-hidden backdrop-blur-md">
            
            <!-- Foto Profil -->
            <div class="aspect-[3/4] rounded-2xl overflow-hidden bg-slate-950 relative">
              <img
                src="./images/dimaz-devriza.jpg"
                alt="Foto Profil Dimaz Devriza, Full-Stack Web Developer"
                width="320"
                height="426"
                fetchpriority="high"
                class="w-full h-full object-cover object-top filter brightness-105 contrast-105 group-hover:scale-102 transition-transform duration-500"
              />
            </div>

            <!-- Floating Translucent Badge -->
            <div class="mt-3 p-3 rounded-xl bg-slate-950/80 border border-white/10 text-xs flex flex-col gap-1.5">
              <div class="flex items-center justify-between text-[11px] font-mono text-slate-400">
                <span>KREDENSIAL TERVERIFIKASI</span>
                <span class="text-emerald-400 font-bold">AKTIF</span>
              </div>
              <div class="flex flex-wrap gap-1.5 font-semibold text-slate-200">
                <span class="px-2 py-0.5 rounded bg-sky-950/80 text-sky-300 border border-sky-800/40 text-[11px]">
                  MikroTik MTCNA
                </span>
                <span class="px-2 py-0.5 rounded bg-blue-950/80 text-blue-300 border border-blue-800/40 text-[11px]">
                  Azure AI
                </span>
                <span class="px-2 py-0.5 rounded bg-purple-950/80 text-purple-300 border border-purple-800/40 text-[11px]">
                  S1 IPK 3,69
                </span>
              </div>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>
